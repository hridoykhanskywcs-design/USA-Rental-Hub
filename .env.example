# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# DATABASE_URL: Optional PostgreSQL / Cloud SQL database connection string
DATABASE_URL=""

# STRIPE: Payment & Subscription processing for landlords & tenants
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# MARKETING & COMMUNICATIONS: SMS / Email campaign gateway
SMS_PROVIDER_KEY=""
EMAIL_API_KEY=""

# CREDIT SCORE & SCREENING PARTNER URL: Default affiliate/screening integration link
DEFAULT_CREDIT_SCORE_LINK="https://smartmove.experian.com/referral/nestryy-verify"

